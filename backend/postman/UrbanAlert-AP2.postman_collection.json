              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"pedro.gomez\",\n  \"password\": \"Clave1234\",\n  \"nombre\": \"Pedro Gomez\",\n  \"dni\": \"70123456\",\n  \"email\": \"pedro@mail.com\",\n  \"telefono\": \"955123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Crea el perfil y la cuenta (rol CIUDADANO). Si se repite devuelve 409."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created, o 409 si ya se ejecuto antes\", function () { pm.expect(pm.response.code).to.be.oneOf([201, 409]); });"
                ]
              }
            }
          ]
        },
