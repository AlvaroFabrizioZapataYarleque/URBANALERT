# UrbanAlert backend — variables de entorno.
# Copiar a backend/.env (ignorado por Git) y completar. Las variables del sistema tienen prioridad sobre este archivo.

# OBLIGATORIA. Secreto JWT en Base64, minimo 256 bits. Generar con:  openssl rand -base64 48
JWT_SECRET=

# Opcional. Vigencia del token en milisegundos (por defecto 7200000 = 2 horas).
JWT_EXPIRATION_MS=7200000

# Opcional. Origenes permitidos por CORS, separados por coma (por defecto http://localhost:4200).
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Solo para el perfil "mysql" (-Dspring-boot.run.profiles=mysql).
DB_URL=jdbc:mysql://localhost:3306/urbanalert?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Lima
DB_USER=root
DB_PASSWORD=
